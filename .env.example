# 키 "이름"만 적는다. 실제 값은 .env (git 제외)에 사용자가 직접 넣는다.
# 에이전트는 .env 를 읽거나 쓰지 않는다 (훅이 막는다). 코드는 os.environ 으로만 읽는다.

# LLM (제품 속 에이전트 · 평가) — 공급자 중립(D11, 등록표 anthropic|openai|gemini).
# LLM_PROVIDER 로 판정기를 고른다: anthropic | openai(기본) | gemini.
LLM_PROVIDER=openai
# LLM_PROVIDERS_ENABLED — 쉼표 구분 활성 목록. 값을 비우면(아래처럼) 표
# 전체(anthropic,openai,gemini)가 켜진다. 끄려면 이름을 명시로 나열한다.
LLM_PROVIDERS_ENABLED=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

# 임베딩 — D4: OpenAI 로 시작, 추후 다른 공급자 키를 추가해 비교
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=

# DB (로컬 docker-compose 기준. 비밀번호는 .env 에서만)
DATABASE_URL=postgresql://app:pass@localhost:5432/relationship
# 위 DATABASE_URL 과 같은 값이어야 한다. 실제 비밀번호는 .env 에만 넣는다.
POSTGRES_USER=app
POSTGRES_PASSWORD=pass
POSTGRES_DB=relationship
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
# 선택. 컨테이너 밖에서 접속할 때만 바꾼다.

# 웹푸시 (P7) — VAPID 키는 .env / SSM 에만
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ER 임계치·가중치 (D3, D10 초기값. 파일럿 후 확정)
T_MERGE=0.8
T_NEW=0.3
W_LLM=0.5
W_EMB=0.3
W_RULE=0.2

# 감점 후보가 자동 연결 구간에 들어왔을 때의 정책 (D13, P4b-er-redesign U3)
# ask  = 사용자에게 물어본다(기본값, 오병합을 막는 쪽)
# merge = 감점을 무시하고 그대로 연결한다
ER_PENALIZED_MERGE_POLICY=ask

APP_ENV=dev

# 로컬 단일 사용자 식별자 (P2-tools 결정9). 값은 예시 -- 비밀 아님.
APP_USER_ID=local

# 사용자 발화의 상대 시각("어제 저녁" 등)을 해석하는 기준 시간대
# (FIX-005). 비우면 Asia/Seoul. DB 저장은 계속 UTC(timestamptz).
APP_TIMEZONE=
