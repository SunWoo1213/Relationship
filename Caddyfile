# Refs: P9-infra D17 R-U10D-2 R-U10D-3 S3.6 결정M
#
# 호스트명은 환경변수 SITE_ADDRESS 로 받는다(하드코딩 없음). 운영은 도메인/호스트명 → 자동 HTTPS,
# 로컬 스모크는 `:80` → HTTP 만.
{$SITE_ADDRESS} {
	encode gzip

	# /api/* → 백엔드. handle_path 가 `/api` 접두를 떼고 넘긴다(백엔드 라우트는 접두가 없다).
	# 404 는 반드시 이 블록 안, reverse_proxy 앞에 둔다 — 최상위 respond 는 Caddy 지시문 순서상
	# handle_path 뒤에 평가돼 /api/docs 가 백엔드 Swagger 로 새어 나간다(02-plan-verify F-P9V-1).
	# 매처는 접두가 떼인 경로다.
	handle_path /api/* {
		@docs path /docs* /redoc* /openapi.json
		respond @docs 404
		reverse_proxy backend:8000
	}

	header /sw.js Cache-Control "no-cache"
	# `header` 의 경로 매처는 요청 경로 기준이다 — `/` 로 받은 index.html 은 `/index.html` 줄에 안 걸린다(R-U1-4).
	# 사라진 해시 자산을 가리키는 낡은 index.html 이 캐시되면 흰 화면이 되므로 `/` 도 no-cache.
	# `/` 는 정확히 그 경로만 맞춘다(와일드카드 없음) — /assets/* 해시 자산의 캐시는 건드리지 않는다.
	header / Cache-Control "no-cache"
	header /index.html Cache-Control "no-cache"
	header /manifest.webmanifest Content-Type "application/manifest+json"
	header -Server

	# 나머지는 프론트 정적 빌드. 라우팅은 해시 기반이라 SPA fallback 은 보험이다.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
