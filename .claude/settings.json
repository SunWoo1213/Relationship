{
  "permissions": {
    "deny": [
      "Write(.claude/.commit-approved)",
      "Edit(.claude/.commit-approved)",
      "Write(.claude/.push-approved)",
      "Edit(.claude/.push-approved)",
      "Write(.claude/.release-approved)",
      "Edit(.claude/.release-approved)",
      "Write(.claude/.awaiting-decision)",
      "Edit(.claude/.awaiting-decision)",
      "Read(./.env)",
      "Read(.env)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfvars)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Bash(sudo:*)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/safety-guard.sh\"",
            "timeout": 15,
            "statusMessage": "보안 가드 확인 중"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/commit-guard.sh\"",
            "timeout": 15,
            "statusMessage": "커밋 승인 가드 확인 중"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/secret-guard.sh\"",
            "timeout": 15,
            "statusMessage": "비밀 유출 검사 중"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/stage-gate.sh\"",
            "timeout": 15,
            "statusMessage": "단계 게이트 확인 중"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/commit-cleanup.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/handoff-check.sh\"",
            "timeout": 20,
            "statusMessage": "HANDOFF 최신성 확인 중"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/precompact.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
